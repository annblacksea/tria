# top-most EditorConfig file
root = true

# Настройки для всех файлов
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

# Настройки для JS/JSX/TS/TSX
# -------------------------------
[*.{js,jsx,ts,tsx}]
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

# Настройки для CSS/SCSS/PostCSS/Tailwind
# -------------------------------
[*.{css,scss,pcss}]
indent_size = 2
trim_trailing_whitespace = true
insert_final_newline = true

# Настройки для JSON файлов
[*.json]
indent_size = 2

# Настройки для Markdown файлов
[*.md]
trim_trailing_whitespace = false
